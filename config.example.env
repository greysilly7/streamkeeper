# Primary manifest endpoint. The service tries mirrors in order if this fails.
AIOSTREAMS_MANIFEST_URL=https://your-aiostreams.example/manifest.json
# Optional credential sent as Bearer and x-aiostreams-password.
AIOSTREAMS_PASSWORD=replace-me
# Comma-separated fallback and mirror endpoints. Replace configure URLs with
# the generated manifest endpoint when an instance requires configuration.
AIOSTREAMS_MIRRORS=https://aiostreams.fortheweak.cloud/stremio/configure,https://aiostreamsfortheweebsstable.midnightignite.me/stremio/configure,https://aiostreams.viren070.me/stremio/configure,https://aiostreams.stremio.ru/stremio/configure,https://aio.atbphosting.com/stremio/configure,https://aiostreams.12312023.xyz/stremio/configure
# Optional; defaults to 7200 seconds (2 hours).
REFRESH_SECONDS=7200
# Optional; defaults to 0.0.0.0:3000.
LISTEN_ADDR=0.0.0.0:3000
